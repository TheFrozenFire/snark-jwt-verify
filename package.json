{
  "name": "@frozenfire/snark-jwt-verify",
  "version": "1.0.0",
  "type": "module",
  "description": "Verify JWTs using SNARK circuits",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "types"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "test": "tsx node_modules/.bin/mocha",
    "build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheFrozenFire/snark-jwt-verify.git"
  },
  "keywords": [
    "circuit",
    "circom",
    "zksnark",
    "rsa",
    "jwt",
    "openid"
  ],
  "author": "thefrozenfire",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TheFrozenFire/snark-jwt-verify/issues"
  },
  "homepage": "https://github.com/TheFrozenFire/snark-jwt-verify#readme",
  "dependencies": {
    "@frozenfire/circom-witness": "^0.6.2",
    "node-rsa": "^1.1.1",
    "snarkjs": "^0.4.10"
  },
  "devDependencies": {
    "@frozenfire/circom-build": "^0.6.2",
    "@types/assert": "^1.5.10",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.10",
    "jose": "^4.3.7",
    "mocha": "^9.1.3",
    "node-jose": "^2.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "mocha": {
    "extension": [
      "ts",
      "js"
    ],
    "require": "tsx/esm",
